# Cloud sync (Supabase) — optional. Copy to `.env` and fill in to enable
# automatic same-data-on-all-devices sync. Left empty, the app runs fully
# offline with manual Export/Import (Settings tab).
#
# Get these from your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
