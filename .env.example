# Cloud sync. A project is already wired into src/lib/cloudConfig.js, so these
# are only needed to point a build at a DIFFERENT Supabase project.
# They are read as a PAIR: setting either one ignores both baked-in defaults
# (and setting only one disables cloud sync rather than mixing two projects).
# For an offline-only build, blank out DEFAULT_URL in src/lib/cloudConfig.js.
# Find both under Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
